# ─────────────────────────────────────────────────────────────
# IFA — environment template. Copy to `.env` and adjust.
# Secrets are read server-side only and never exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
APP_VERSION=0.2.0
LOG_LEVEL=info

# Database.
#  - Canonical production: PostgreSQL   postgres://ifa:ifa@localhost:5432/ifa
#  - Zero-setup dev/demo:  in-process Postgres via PGlite
#      pglite://./.pgdata   (persistent)   or   pglite://memory
DATABASE_URL=pglite://./.pgdata

# Demo mode: when true, IFA runs from seed data and shows the DEMO DATA banner.
IFA_DEMO_MODE=true

# Intelligence provider: mock | openai | anthropic | openai-compatible
# `mock` is deterministic and keyless — the default for dev, tests and demos.
AI_PROVIDER=mock
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=

# Embeddings: mock (deterministic, keyless) | openai-compatible | none
EMBEDDINGS_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# Ingestion
INGEST_MAX_BYTES=4000000
INGEST_TIMEOUT_MS=15000
INGEST_MAX_REDIRECTS=3
INGEST_USER_AGENT=IFA/0.2 (+https://github.com/Rishidar-lab/ifa; news aggregation for research)
# Allow ingestion to reach private / loopback / link-local addresses. Keep false.
INGEST_ALLOW_PRIVATE_NETWORK=false
# Comma-separated host allowlist for ingestion (empty = allow any public host).
INGEST_HOST_ALLOWLIST=

# When set, POST /api/ingest, /analyze and /admin/* require this bearer token.
# IFA_WRITE_TOKEN=change-me
