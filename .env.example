# ─────────────────────────────────────────────────────────────
# IFA — environment template. Copy to `.env` and adjust.
# Secrets are read server-side only and never exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=info

# Database (SQLite for v0.1). Use a `file:` URL.
# The Postgres migration path is documented in docs/ARCHITECTURE.md.
DATABASE_URL=file:./ifa.db

# Demo mode: when true, IFA runs entirely from seed data.
# No API keys, no outbound network, no ingestion required.
IFA_DEMO_MODE=true

# Intelligence provider: mock | openai | anthropic | openai-compatible
# `mock` is deterministic and requires no key — the default for dev, tests and demos.
AI_PROVIDER=mock
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=

# Ingestion safety
INGEST_MAX_BYTES=2000000
# Allow ingestion to reach private / loopback / link-local addresses. Keep false.
INGEST_ALLOW_PRIVATE_NETWORK=false
# Comma-separated host allowlist for ingestion (empty = allow any public host).
INGEST_HOST_ALLOWLIST=
