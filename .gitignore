# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IFA local
/ifa.db
/ifa.db-*
/e2e.db
/e2e.db-*
*.db
*.db-journal
*.db-wal
*.db-shm
/test-results
/playwright-report
/blob-report
/playwright/.cache

# keep the template
!.env.example
qa-prod/

# IFA data hygiene (docs/DATA-HYGIENE.md): the ACTIVE live-feed snapshot is a
# volatile build artefact seeded from src/data/fixtures/live-feed.seed.json and
# overwritten by every `npm run ingest`. It must never create repository churn.
/src/data/generated/live-feed.json
!/src/data/generated/.gitkeep

# Evaluation run archives — regenerated by `npm run eval:claims`. Only the
# canonical result (evaluation/reports/latest.json + latest.md), which the
# public quality dashboard reads, is version-controlled.
/evaluation/reports/run-*.json
/evaluation/reports/run-*.md

# Stale artefacts from the pre-comparison-MVP architecture (never tracked)
/artifacts/
/config/
