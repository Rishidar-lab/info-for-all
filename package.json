{
  "name": "iffa",
  "version": "0.11.0",
  "private": true,
  "description": "IFFA — Info Free For All. A Tamil Nadu-first, India-aware real-time news and current-trend intelligence platform: reporting grouped into events, ranked by what is actually changing, with source independence, claim provenance and Tamil↔English semantics made visible.",
  "scripts": {
    "prepare-data": "tsx scripts/prepare-data.ts",
    "predev": "tsx scripts/prepare-data.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/prepare-data.ts && tsx scripts/research-pass.ts && tsx scripts/shard-dataset.ts",
    "research": "tsx scripts/research-pass.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "tsx scripts/prepare-data.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "tsx scripts/prepare-data.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "ingest": "tsx scripts/prepare-data.ts && tsx scripts/ingest-feeds.ts",
    "seed:refresh": "tsx scripts/seed-refresh.ts",
    "validate:feed": "tsx scripts/validate-feed.ts",
    "eval:claims": "tsx scripts/eval-claims.ts",
    "eval:category": "tsx scripts/eval-category.ts",
    "eval:cgi": "tsx scripts/eval-cgi.ts",
    "eval:identity": "tsx scripts/eval-identity.ts",
    "eval:misses": "tsx scripts/analyze-misses.ts",
    "quality-gate": "tsx scripts/quality-gate.ts",
    "audit:identity": "tsx scripts/identity-live-audit.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "ingest:discourse": "tsx scripts/ingest-discourse.ts",
    "history:append": "tsx scripts/history-append.ts",
    "source-discovery-audit": "tsx scripts/source-discovery-audit.ts",
    "eval:stance": "tsx scripts/eval-stance.ts",
    "eval:framing": "tsx scripts/eval-framing.ts",
    "eval:evidence": "tsx scripts/eval-evidence.ts",
    "shard": "tsx scripts/shard-dataset.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "openai": "^6.10.0"
  }
}
